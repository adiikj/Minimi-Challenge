# ---- Required ----
# Mistral API key (https://console.mistral.ai). Serves GLM 5.3, Mistral Large 4 and Small 4.
MISTRAL_API_KEY=
# Tavily search API key (https://app.tavily.com). Free tier: ~1,000 searches/month, no card.
TAVILY_API_KEY=

# ---- Optional (defaults shown) ----
# Main chat model.
AGENT_MODEL=zai-glm-5-3
# Background model for memory extraction (cheap, reasoning off).
AGENT_BACKGROUND_MODEL=mistral-small-2603
# Pin the agent's clock (ISO 8601) for demos/evals, e.g. 2026-11-11T10:00:00+05:30. Empty = real time.
AGENT_NOW=
# Hard stop on LLM spend in USD for this install (0 = no limit).
SPEND_LIMIT_USD=4
# SQLite database location.
DATABASE_PATH=./data/agent.db
# Search mode: live (real Tavily) | record (real + save responses) | replay (saved responses only, 0 credits).
SEARCH_MODE=live
SEARCH_FIXTURES_DIR=./evals/fixtures/search
# Memory-driven prefetch: start searches for recalled items before the model's first call (on | off).
PREFETCH=on
